:[{"en":"Take an umbrella. It's raining.","zh":"带上雨伞，外面在下雨。","src":"拓展"},{"en":"We shared an umbrella on the walk home.","zh":"走路回家时，我们共撑一把伞。","src":"拓展"}],"col":[],"fam":[],"syn":[],"ant":[],"tip":"","cefr":"核心短语与词汇","topic":"basic","m":31,"unit":"核心短语与词汇"},{"id":"throw-away","w":"throw … away","uk":"","us":"","senses":[{"pos":"","zh":"把……扔掉","en":""}],"ex":[{"en":"Don't throw the leftovers away.","zh":"别把剩菜扔掉。","src":"拓展"}],"col":[],"fam":[],"syn":[],"ant":[],"tip":"","cefr":"核心短语与词汇","topic":"phrase","m":13,"unit":"核心短语与词汇"},{"id":"personally","w":"personally","uk":"/ˈpɜːsənəli/","us":"/ˈpɝːsənəli/","senses":[{"pos":"","zh":"就我个人而言；亲自","en":""}],"ex":[{"en":"Personally, I like to put my phone away at dinner.","zh":"就我个人而言，我喜欢吃饭时把手机收起来。","src":"拓展"},{"en":"Personally, I prefer walking to taking the bus.","zh":"就我个人而言，我更喜欢步行而不是乘公交车。","src":"拓展"}],"col":[],"fam":[],"syn":[],"ant":[],"tip":"","cefr":"核心短语与词汇","topic":"basic","m":31,"unit":"核心短语与词汇"},{"id":"a-few-seconds","w":"a few seconds","uk":"","us":"","senses":[{"pos":"","zh":"几秒钟","en":""}],"ex":[{"en":"Wait a few seconds before you start.","zh":"开始之前等几秒钟。","src":"拓展"}],"col":[],"fam":[],"syn":[],"ant":[],"tip":"","cefr":"核心短语与词汇","topic":"phrase","m":13,"unit":"核心短语与词汇"},{"id":"in-the-moment","w":"in the moment","uk":"","us":"","senses":[{"pos":"","zh":"在当下；在此刻","en":""}],"ex":[{"en":"Put away your phone and enjoy being in the moment.","zh":"收起手机，享受当下。","src":"拓展"}],"col":[],"fam":[],"syn":[],"ant":[],"tip":"","cefr":"核心短语与词汇","topic":"phrase","m":13,"unit":"核心短语与词汇"},{"id":"share-food-online","w":"share food online","uk":"","us":"","senses":[{"pos":"","zh":"在网上分享美食（照片或视频）","en":""}],"ex":[{"en":"Many people share food online by posting photos.","zh":"很多人通过发布照片在网上分享美食。","src":"拓展"}],"col":[],"fam":[],"syn":[],"ant":[],"tip":"","cefr":"核心短语与词汇","topic":"phrase","m":13,"unit":"核心短语与词汇"},{"id":"through-social-media","w":"through social media","uk":"","us":"","senses":[{"pos":"","zh":"通过社交媒体","en":""}],"ex":[{"en":"They keep in touch through social media.","zh":"他们通过社交媒体保持联系。","src":"拓展"}],"col":[],"fam":[],"syn":[],"ant":[],"tip":"","cefr":"核心短语与词汇","topic":"phrase","m":13,"unit":"核心短语与词汇"}]