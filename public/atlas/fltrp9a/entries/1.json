s":"n.","zh":"实验","en":""}],"col":[],"fam":[],"syn":[],"ant":[],"tip":"","cefr":"Unit 4","topic":"basic","page":61,"key":false,"unit":"unit-4"},{"id":"fltrp9a-scientific-research","w":"scientific research","uk":"","m":2,"us":"","ex":[],"senses":[{"pos":"","zh":"科学研究","en":""}],"col":[],"fam":[],"syn":[],"ant":[],"tip":"","cefr":"Unit 4","topic":"phrase","page":61,"key":false,"unit":"unit-4"},{"id":"fltrp9a-type","w":"type","uk":"/taɪp/","m":15,"us":"/taɪp/","ex":[{"en":"What type of bread would you like today?","zh":"你今天想要哪种面包？","src":"词光 Word Atlas"},{"en":"Different types of public transport are needed to serve both urban and rural communities.","zh":"城市和农村社区都需要不同类型的公共交通服务。","src":"词光 Word Atlas"}],"senses":[{"pos":"n.","zh":"类型，种类","en":""}],"col":[],"fam":[],"syn":[],"ant":[],"tip":"","cefr":"Unit 4","topic":"basic","page":61,"key":false,"unit":"unit-4"},{"id":"fltrp9a-poor","w":"poor","uk":"/pɔː/","m":2,"us":"","ex":[],"senses":[{"pos":"adj.","zh":"差的，不佳的","en":""}],"col":[],"fam":[],"syn":[],"ant":[],"tip":"","cefr":"Unit 4","topic":"key","page":61,"key":true,"unit":"unit-4"},{"id":"fltrp9a-soil","w":"soil","uk":"/sɔɪl/","m":15,"us":"/sɔɪl/","ex":[{"en":"She filled the pot with soil and planted seeds.","zh":"她往花盆里填了土，然后种下种子。","src":"词光 Word Atlas"},{"en":"Intensive farming can damage soil quality, reducing the land's ability to support crops over time.","zh":"集约化农业可能损害土壤质量，逐渐降低土地种植作物的能力。","src":"词光 Word Atlas"}],"senses":[{"pos":"n.","zh":"土壤，土地，泥土","en":""}],"col":[],"fam":[],"syn":[],"ant":[],"tip":"","cefr":"Unit 4","topic":"key","page":61,"key":true,"unit":"unit-4"},{"id":"fltrp9a-feed","w":"feed","uk":"/fiːd/","m":2,"us":"","ex":[],"senses":[{"pos":"v.","zh":"养活","en":""}],"col":[],"fam":[],"syn":[],"ant":[],"tip":"","cefr":"Unit 4","topic":"key","page":61,"key":true,"unit":"unit-4"},{"id":"fltrp9a-pass-away","w":"pass away","uk":"","m":2,"us":"","ex":[],"senses":[{"pos":"","zh":"过世，离世","en":""}],"col":[],"fam":[],"syn":[],"ant":[],"tip":"","cefr":"Unit 4