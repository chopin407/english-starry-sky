-4"},{"id":"fltrp9a-leave-behind","w":"leave... behind","uk":"","m":2,"us":"","ex":[],"senses":[{"pos":"","zh":"离开，丢下","en":""}],"col":[],"fam":[],"syn":[],"ant":[],"tip":"","cefr":"Unit 4","topic":"phrase","page":53,"key":false,"unit":"unit-4"},{"id":"fltrp9a-gentle","w":"gentle","uk":"/ˈdʒentl/","m":15,"us":"/ˈdʒentəl/","ex":[{"en":"Be gentle when you pick up the little kitten.","zh":"抱起那只小猫时，动作要轻柔。","src":"词光 Word Atlas"},{"en":"Gentle exercise, such as walking or swimming, can improve physical health without placing excessive strain on joints.","zh":"散步或游泳等温和运动可以改善身体健康，又不会给关节带来过大负担。","src":"词光 Word Atlas"}],"senses":[{"pos":"adj.","zh":"温和的，温柔的","en":""}],"col":[],"fam":[],"syn":[],"ant":[],"tip":"","cefr":"Unit 4","topic":"basic","page":53,"key":false,"unit":"unit-4"},{"id":"fltrp9a-pity","w":"pity","uk":"/ˈpɪti/","m":2,"us":"","ex":[],"senses":[{"pos":"n.","zh":"可惜，遗憾","en":""}],"col":[],"fam":[],"syn":[],"ant":[],"tip":"","cefr":"Unit 4","topic":"key","page":53,"key":true,"unit":"unit-4"},{"id":"fltrp9a-war","w":"war","uk":"/wɔː/","m":31,"us":"/wɔːr/","ex":[{"en":"The museum displays uniforms worn during the war.","zh":"博物馆展出了战争期间穿过的军服。","src":"词光 Word Atlas"},{"en":"War can disrupt children's education and force families to leave their homes in search of safety.","zh":"战争可能打断儿童的学业，迫使家庭离开家园寻求安全。","src":"词光 Word Atlas"}],"senses":[{"pos":"n.","zh":"战争","en":""}],"col":[],"fam":[],"syn":[],"ant":[],"tip":"","cefr":"Unit 4","topic":"key","page":54,"key":true,"unit":"unit-4"},{"id":"fltrp9a-battle","w":"battle","uk":"/ˈbætl/","m":15,"us":"/ˈbætəl/","ex":[{"en":"The museum displays armour from a famous battle.","zh":"博物馆展出了某场著名战役中使用的盔甲。","src":"词光 Word Atlas"},{"en":"The battle against air pollution requires coordinated action from governments, businesses, and individuals across urban areas.","zh":"对抗空气污染需要城市各地的政府、企业和个人协调行动。","src":"词光 Word Atlas"}],"senses":[{"pos":"n.","zh":"战斗，战役","en":""}],"col":[],"fam":[],"syn":[],"ant":[],"tip":"","cefr":"Unit 4","topic":"basic","page":55,"key":false,"unit":"unit-4"},{"id":"fltrp9a-shock","w":"shock","uk":"/ʃɒk/","m":2,"us":"","ex":[],"senses":[{"pos":"n.","zh":"令人震惊的事","en":""}],"col":[],"fam":[],"syn":[],"ant":[],"tip":"","cefr":"Unit 4","topic":"key","page":55,"key":true,"unit":"unit-4"},{"id":"fltrp9a-survivor","w":"survivor","uk":"/səˈvaɪvə/","m":15,"us":"/sərˈvaɪvər/","ex":[{"en":"Rescuers pulled a survivor from the flooded house.","zh":"救援人员从被淹的房屋中救出了一名幸存者。","src":"词光 Word Atlas"},{"en":"Every disaster survivor should have access to safe housing, medical treatment, and long-term psychological support.","zh":"每位灾难幸存者都应能获得安全住所、医疗服务和长期心理支持。","src":"词光 Word Atlas"}],"senses":[{"pos":"n.","zh":"生还者，幸存者","en":""}],"col":[],"fam":[],"syn":[],"ant":[],"tip":"","cefr":"Unit 4","topic":"key","page":55,"key":true,"unit":"unit-4"},{"id":"fltrp9a-temperature","w":"temperature","uk":"/ˈtemprətʃə/","m":15,"us":"/ˈtemprətʃər/","ex":[{"en":"The temperature dropped sharply after the sun went down.","zh":"太阳落山后，气温急剧下降。","src":"词光 Word Atlas"},{"en":"Rising ocean temperatures can damage coral reefs and threaten the survival of many marine species.","zh":"海洋温度上升会破坏珊瑚礁，并威胁许多海洋物种的生存。","src":"词光 Word Atlas"}],"senses":[{"pos":"n.","zh":"温度，气温","en":""}],"col":[],"fam":[],"syn":[],"ant":[],"tip":"","cefr":"Unit 4","topic":"key","page":55,"key":true,"unit":"unit-4"},{"id":"fltrp9a-post-u4","w":"post","uk":"/pəʊst/","m":2,"us":"","ex":[],"senses":[{"pos":"n.","zh":"岗位","en":""}],"col":[],"fam":[],"syn":[],"ant":[],"tip":"","cefr":"Unit 4","topic":"key","page":55,"key":true,"unit":"unit-4"},{"id":"fltrp9a-front-line","w":"front line","uk":"","m":2,"us":"","ex":[],"senses":[{"pos":"","zh":"前线","en":""}],"col":[],"fam":[],"syn":[],"ant":[],"tip":"","cefr":"Unit 4","topic":"phrase","page":55,"key":false,"unit":"unit-4"},{"id":"fltrp9a-lose","w":"lose","uk":"/luːz/","m":2,"us":"","ex":[],"senses":[{"pos":"v.","zh":"丧失，失去","en":""}],"col":[],"fam":[],"syn":[],"ant":[],"tip":"","cefr":"Unit 4","topic":"key","pa