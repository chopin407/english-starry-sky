ing bat habitats can benefit agriculture because many species feed on insects that damage crops.","zh":"保护蝙蝠栖息地能使农业受益，因为许多蝙蝠以危害农作物的昆虫为食。","src":"词光 Word Atlas"}],"senses":[{"pos":"n.","zh":"蝙蝠","en":""}],"col":[],"fam":[],"syn":[],"ant":[],"tip":"","cefr":"Unit 3","topic":"key","page":45,"key":true,"unit":"unit-3"},{"id":"fltrp9a-scarf","w":"scarf","uk":"/skɑːf/","m":15,"us":"/skɑːrf/","ex":[{"en":"She wrapped a wool scarf around her neck.","zh":"她在脖子上围了一条羊毛围巾。","src":"词光 Word Atlas"},{"en":"In colder regions, a locally woven scarf can reflect traditional craftsmanship while providing essential warmth.","zh":"在较寒冷的地区，当地织造的围巾既能体现传统手艺，又能提供必要的保暖。","src":"词光 Word Atlas"}],"senses":[{"pos":"n.","zh":"围巾；披肩","en":""}],"col":[],"fam":[],"syn":[],"ant":[],"tip":"","cefr":"Unit 3","topic":"key","page":45,"key":true,"unit":"unit-3"},{"id":"fltrp9a-fridge","w":"fridge","uk":"/frɪdʒ/","m":31,"us":"/frɪdʒ/","ex":[{"en":"Put the milk back in the fridge, please.","zh":"请把牛奶放回冰箱。","src":"词光 Word Atlas"},{"en":"Choosing an energy-efficient fridge can reduce household electricity consumption and lower costs over time.","zh":"选择节能冰箱可以减少家庭用电量，并在长期内降低开支。","src":"词光 Word Atlas"}],"senses":[{"pos":"n.","zh":"冰箱，冰柜","en":""}],"col":[],"fam":[],"syn":[],"ant":[],"tip":"","cefr":"Unit 3","topic":"key","page":45,"key":true,"unit":"unit-3"},{"id":"fltrp9a-fridge-magnet","w":"fridge magnet","uk":"","m":2,"us":"","ex":[],"senses":[{"pos":"","zh":"冰箱磁贴","en":""}],"col":[],"fam":[],"syn":[],"ant":[],"tip":"","cefr":"Unit 3","topic":"phrase","page":45,"key":false,"unit":"unit-3"},{"id":"fltrp9a-mirror","w":"mirror","uk":"/ˈmɪrə/","m":2,"us":"","ex":[],"senses":[{"pos":"v.","zh":"反映","en":""}],"col":[],"fam":[],"syn":[],"ant":[],"tip":"","cefr":"Unit 3","topic":"key","page":45,"key":true,"unit":"unit-3"},{"id":"fltrp9a-great-aunt","w":"great-aunt","uk":"/ˌɡreɪtˈɑːnt/","m":2,"us":"","ex":[],"senses":[{"pos":"n.","zh":"舅婆；姑婆；姨婆；叔祖母；伯祖母","en":""}],"col":[],"fam":[],"syn":[],"ant":[],"tip":"","cefr":"Un