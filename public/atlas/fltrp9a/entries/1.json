am":[],"syn":[],"ant":[],"tip":"","cefr":"Unit 5","topic":"key","page":69,"key":true,"unit":"unit-5"},{"id":"fltrp9a-society","w":"society","uk":"/səˈsaɪəti/","m":15,"us":"/səˈsaɪəti/","ex":[{"en":"Everyone has a part to play in society.","zh":"每个人都能在社会中发挥作用。","src":"词光 Word Atlas"},{"en":"An ageing society requires accessible healthcare and policies that support older people's independence.","zh":"老龄化社会需要便捷可及的医疗服务，以及支持老年人独立生活的政策。","src":"词光 Word Atlas"}],"senses":[{"pos":"n.","zh":"社会","en":""}],"col":[],"fam":[],"syn":[],"ant":[],"tip":"","cefr":"Unit 5","topic":"key","page":69,"key":true,"unit":"unit-5"},{"id":"fltrp9a-cancel","w":"cancel","uk":"/ˈkænsəl/","m":15,"us":"/ˈkænsəl/","ex":[{"en":"We had to cancel our picnic because of heavy rain.","zh":"由于下大雨，我们不得不取消野餐。","src":"词光 Word Atlas"},{"en":"Improved energy efficiency may cancel out some environmental benefits if it encourages people to consume more.","zh":"如果能源效率提高促使人们增加消费，就可能抵消部分环境效益。","src":"词光 Word Atlas"}],"senses":[{"pos":"v.","zh":"取消","en":""}],"col":[],"fam":[],"syn":[],"ant":[],"tip":"","cefr":"Unit 5","topic":"key","page":69,"key":true,"unit":"unit-5"},{"id":"fltrp9a-start-over","w":"start over","uk":"","m":2,"us":"","ex":[],"senses":[{"pos":"","zh":"重新开始，从头来过","en":""}],"col":[],"fam":[],"syn":[],"ant":[],"tip":"","cefr":"Unit 5","topic":"phrase","page":69,"key":false,"unit":"unit-5"},{"id":"fltrp9a-get-along-with","w":"get along with","uk":"","m":2,"us":"","ex":[],"senses":[{"pos":"","zh":"与……相处融洽","en":""}],"col":[],"fam":[],"syn":[],"ant":[],"tip":"","cefr":"Unit 5","topic":"phrase","page":69,"key":false,"unit":"unit-5"},{"id":"fltrp9a-permit","w":"permit","uk":"/pəˈmɪt/","m":15,"us":"/pɚˈmɪt/","ex":[{"en":"The museum permits visitors to take photos without flash.","zh":"这家博物馆允许游客在不开闪光灯的情况下拍照。","src":"词光 Word Atlas"},{"en":"Local authorities should permit new housing developments only when adequate transport and healthcare services are available.","zh":"地方政府只有在交通和医疗服务充足时，才应批准新的住宅开发项目。","src":"词光 Word Atlas"}],"senses":[{"pos":"v.","zh":"允许","en":""}],"col":[],"fam":[],"syn":[],"ant":[],"tip":"","cefr":"Unit 5","topic":"basic","page":69,"key":false,"unit":"unit-5"},{"id":"fltrp9a-affect","w":"affect","uk":"/əˈfekt/","m":15,"us":"/əˈfekt/","ex":[{"en":"Too much coffee can affect how well you sleep.","zh":"喝太多咖啡会影响你的睡眠质量。","src":"词光 Word Atlas"},{"en":"Rising food prices disproportionately affect poorer households, which spend a larger share of their income on essentials.","zh":"食品价格上涨对较贫困家庭的影响尤为严重，因为必需品支出占其收入的比例更大。","src":"词光 Word Atlas"}],"senses":[{"pos":"v.","zh":"影响","en":""}],"col":[],"fam":[],"syn":[],"ant":[],"tip":"","cefr":"Unit 5","topic":"basic","page":71,"key":false,"unit":"unit-5"},{"id":"fltrp9a-organisation","w":"organisation","uk":"/ˌɔːɡənaɪˈzeɪʃən/","m":15,"us":"/ˌɔːrɡənəˈzeɪʃən/","ex":[{"en":"He joined a local organisation that rescues injured birds.","zh":"他加入了一个救助受伤鸟类的当地组织。","src":"词光 Word Atlas"},{"en":"Effective organisation of healthcare services can shorten waiting times and improve access for rural communities.","zh":"有效组织医疗服务能够缩短等候时间，并改善农村社区获得医疗服务的机会。","src":"词光 Word Atlas"}],"senses":[{"pos":"n.","zh":"组织，团体，机构","en":""}],"col":[],"fam":[],"syn":[],"ant":[],"tip":"","cefr":"Unit 5","topic":"key","page":71,"key":true,"unit":"unit-5"},{"id":"fltrp9a-harm","w":"harm","uk":"/hɑːm/","m":15,"us":"/hɑːrm/","ex":[{"en":"Too much sunlight can harm the leaves of this plant.","zh":"阳光过强会损伤这种植物的叶子。","src":"词光 Word Atlas"},{"en":"Stricter controls on industrial waste could reduce the harm caused to rivers and protect local wildlife.","zh":"加强对工业废弃物的管控可以减少河流受到的损害，并保护当地野生动物。","src":"词光 Word Atlas"}],"senses":[{"pos":"v.","zh":"伤害","en":""}],"col":[],"fam":[],"syn":[],"ant":[],"tip":"","cefr":"Unit 5","topic":"key","page":71,"key":true,"unit":"unit-5"},{"id":"fltrp9a-punish","w":"punish","uk":"/ˈpʌnɪʃ/","m":15,"us":"/ˈpʌnɪʃ/","ex":[{"en":"The referee punished the player for breaking the rules.","zh":"裁判因那名球员违反规则而对其作出处罚。","src":"词光 Word Atlas"},{